<Window
    x:Class="Autocad_Primavera_P6_Plugin.UserInterface.UI_LinkedFoldersManagerView.LinkedFoldersManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui_linkedfoldersmanagerview="clr-namespace:Autocad_Primavera_P6_Plugin.UserInterface.UI_LinkedFoldersManagerView"
    Title="Linked Folders Manager - Enhanced"
    Width="900"
    Height="600"
    d:DataContext="{d:DesignInstance Type=ui_linkedfoldersmanagerview:LinkedFoldersManagerViewModel}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <!--  Status color converter  -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Margin="0,0,0,15">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Foreground="#2C3E50"
                Text="Linked Folders Manager" />
            <TextBlock
                Margin="0,5,0,0"
                FontSize="12"
                Foreground="#7F8C8D"
                Text="Manage AutoCAD Primavera P6 Plugin folder links" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="LINK" />
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Margin="20,0,20,0"
                IsEnabled="{Binding IsLinkNameTextBoxEnabled}"
                Text="{Binding LinkNameText}" />
            <Grid Grid.Row="1" Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="25" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,2,0"
                    Command="{Binding SaveProjectConfigCommand}"
                    Content="Save" />
                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="2,0,0,0"
                    Command="{Binding ResetProjectConfigCommand}"
                    Content="+" />
            </Grid>
            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text=" |- " />
            <TextBlock
                Grid.Row="3"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="FOLDER" />
            <TextBox
                Grid.Row="3"
                Grid.Column="2"
                Margin="20,0,20,0"
                IsEnabled="False"
                Text="{Binding FolderPathText, Mode=OneWay}"
                ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                ToolTipService.ShowOnDisabled="True" />
            <Button
                Grid.Row="3"
                Grid.Column="3"
                Command="{Binding SelectFolderCommand}"
                Content="Select Folder" />
            <TextBlock
                Grid.Row="5"
                Grid.Column="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text=" |- " />
            <TextBlock
                Grid.Row="5"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text=" P6-PROJECT" />
            <TextBox
                Grid.Row="5"
                Grid.Column="2"
                Margin="20,0,20,0"
                IsEnabled="False"
                Text="{Binding ProjectSelectorText, Mode=OneWay}"
                ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                ToolTipService.ShowOnDisabled="True" />
            <Button
                Grid.Row="5"
                Grid.Column="3"
                Command="{Binding SelectProjectCommand}"
                Content="Select Project" />
        </Grid>

        <!--  Input Section  -->
        <ListBox
            Grid.Row="2"
            Margin="0,5,0,10"
            ScrollViewer.VerticalScrollBarVisibility="Auto" />

    </Grid>
</Window>
