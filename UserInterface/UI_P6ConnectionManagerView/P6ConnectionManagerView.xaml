<Window
    x:Class="Autocad_Primavera_P6_Plugin.UserInterface.UI_P6ConnectionManagerView.P6ConnectionManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Autocad_Primavera_P6_Plugin.UserInterface.UI_P6ConnectionManagerView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="P6 Connection Manager"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance Type=local:P6ConnectionManagerViewModel}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,0,0,10"
            FontSize="18"
            FontWeight="Bold"
            Text="P6 Connections" />

        <ListBox
            Grid.Row="1"
            MinHeight="200"
            Margin="0,0,0,10"
            ItemsSource="{Binding P6Connections}"
            SelectedItem="{Binding SelectedConnection, Mode=TwoWay}" />

        <StackPanel
            Grid.Row="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="110"
                Margin="0,0,10,0"
                Command="{Binding AddConnectionCommand}"
                Content="Add Connection" />
        </StackPanel>
    </Grid>
</Window>
