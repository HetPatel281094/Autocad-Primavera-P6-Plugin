<Window
    x:Class="Autocad_Primavera_P6_Plugin.UserInterface.UI_UserControls.UI_P6ProjectSelector.P6ProjectSelectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Autocad_Primavera_P6_Plugin.UserInterface.UI_UserControls.UI_P6ProjectSelector"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="600"
    mc:Ignorable="d">

    <Border>
        <Grid Background="#F0F0F0" Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,0,0,5">
                <TextBlock
                    Margin="5"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="#2C3E50"
                    Text="Select Primavera P6 Project" />
                <TextBlock
                    Margin="5"
                    FontSize="12"
                    Foreground="#7F8C8D"
                    Text="Use this dialog to find and select Primavera P6 project(s)." />
            </StackPanel>

            <Grid
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Margin="5"
                    Text="{Binding SearchString}" />
                <Button
                    Grid.Column="1"
                    Margin="5"
                    Command="{Binding SearchButtonCommand}"
                    Content="Search" />
            </Grid>

            <Grid Grid.Row="2" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Height="24"
                    Background="#EAEAEA">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" SharedSizeGroup="ProjIdColumn" />
                        <ColumnDefinition Width="2" />
                        <ColumnDefinition Width="*" SharedSizeGroup="ProjNameColumn" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Project ID" />
                    <Border
                        Grid.Column="1"
                        Width="1"
                        HorizontalAlignment="Center"
                        Background="#BCBCBC" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Project Name" />
                </Grid>

                <TreeView
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    Background="White"
                    BorderThickness="0"
                    ItemsSource="{Binding RootNodes}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Visibility" Value="{Binding IsVisible, Mode=TwoWay}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Style.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                            </Style.Resources>
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:P6NodeViewModel}" ItemsSource="{Binding Children}">
                            <Border
                                x:Name="RowBackground"
                                MinHeight="22"
                                HorizontalAlignment="Stretch"
                                BorderBrush="#EAEAEA"
                                BorderThickness="0,0,0,1">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Grid.Column="0"
                                        Margin="2,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Polygon
                                            x:Name="EpsIcon"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Fill="#D4AF37"
                                            Points="6,1 12,11 0,11"
                                            Stroke="#8B7500"
                                            StrokeThickness="0.5"
                                            Visibility="Collapsed" />

                                        <TextBlock
                                            x:Name="ProjectIcon"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#A9B9C9"
                                            Text="📁"
                                            Visibility="Collapsed" />

                                        <TextBlock
                                            x:Name="TxtId"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="{Binding Id}" />
                                    </StackPanel>

                                    <TextBlock
                                        x:Name="TxtName"
                                        Grid.Column="1"
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>

                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsProject}" Value="false">
                                    <Setter TargetName="EpsIcon" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="RowBackground" Property="Background" Value="#0000FF" />
                                    <Setter TargetName="TxtId" Property="Foreground" Value="#FFFF00" />
                                    <Setter TargetName="TxtId" Property="FontWeight" Value="Bold" />
                                    <Setter TargetName="TxtName" Property="Foreground" Value="#FFFF00" />
                                    <Setter TargetName="TxtName" Property="FontWeight" Value="Bold" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding IsProject}" Value="true">
                                    <Setter TargetName="ProjectIcon" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="RowBackground" Property="Background" Value="Transparent" />
                                    <Setter TargetName="TxtId" Property="Foreground" Value="#000000" />
                                    <Setter TargetName="TxtName" Property="Foreground" Value="#000000" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="RowBackground" Property="Background" Value="#0078D7" />
                                    <Setter TargetName="TxtId" Property="Foreground" Value="White" />
                                    <Setter TargetName="TxtName" Property="Foreground" Value="White" />
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </Grid>

            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="5"
                    Command="{Binding OkButtonCommand}"
                    Content="Ok"
                    IsEnabled="{Binding IsProjectSelected}" />
                <Button
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="5"
                    Command="{Binding CancelButtonCommand}"
                    Content="Cancel" />
            </Grid>

        </Grid>
    </Border>
</Window>
