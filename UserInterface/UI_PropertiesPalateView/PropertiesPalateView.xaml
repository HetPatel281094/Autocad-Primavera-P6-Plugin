<UserControl x:Class="Autocad_Primavera_P6_Plugin.UserInterface.UI_PropertiesPalateView.PropertiesPalateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Autocad_Primavera_P6_Plugin.UserInterface.UI_PropertiesPalateView"
             d:DataContext="{d:DesignInstance Type=local:PropertiesPalateViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d"
             Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Properties" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Properties}"
                 SelectedItem="{Binding SelectedProperty, Mode=TwoWay}"
                 Margin="0,0,0,10"
                 MinHeight="200"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Load Properties" Width="110" Margin="0,0,10,0"
                    Command="{Binding LoadPropertiesCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
