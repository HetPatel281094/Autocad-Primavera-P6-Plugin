<UserControl
    x:Class="Autocad_Primavera_P6_Plugin.UserInterface.UI_PropertiesPalateView.PropertiesPalateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Autocad_Primavera_P6_Plugin.UserInterface.UI_PropertiesPalateView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:PropertiesPalateViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="White"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,0,0,10"
            FontSize="18"
            FontWeight="Bold"
            Text="Properties" />

        <ListBox
            Grid.Row="1"
            MinHeight="200"
            Margin="0,0,0,10"
            ItemsSource="{Binding Properties}"
            SelectedItem="{Binding SelectedProperty, Mode=TwoWay}" />

        <StackPanel
            Grid.Row="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="110"
                Margin="0,0,10,0"
                Command="{Binding LoadPropertiesCommand}"
                Content="Load Properties" />
        </StackPanel>
    </Grid>
</UserControl>
