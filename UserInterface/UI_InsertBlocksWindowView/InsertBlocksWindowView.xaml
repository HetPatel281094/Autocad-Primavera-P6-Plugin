<Window
    x:Class="Autocad_Primavera_P6_Plugin.UserInterface.UI_InsertBlocksWindowView.InsertBlocksWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Autocad_Primavera_P6_Plugin.UserInterface.UI_InsertBlocksWindowView"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="P6 AutoCAD - Insert Blocks"
    Width="520"
    Height="1100"
    MinWidth="500"
    MinHeight="620"
    ResizeMode="CanResize"
    Topmost="True"
    
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <local:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        <local:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="8,6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="#B8B8B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FAFAFA" />
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style
            x:Key="FieldLabelStyle"
            BasedOn="{StaticResource ValueTextStyle}"
            TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#333333" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="6">

            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="BOUNDARY ACTIVITY CODE" />

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BoundaryCode.IsAutoGenerate}" Value="True">
                                        <Setter Property="Opacity" Value="0.45" />
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="Code Value" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding BoundaryCode.SelectedCodeValue}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="Code Description" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding BoundaryCode.SelectedCodeDescription}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="Code Path" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding BoundaryCode.SelectedCodePath}" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="Code Value Id" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding BoundaryCode.SelectedCodeValueId}" />
                    </Grid>

                    <DockPanel Margin="0,6">
                        <Button
                            Width="96"
                            Margin="6,0,0,0"
                            HorizontalAlignment="Right"
                            Command="{Binding BoundaryCode.SelectCodeCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="Select"
                            DockPanel.Dock="Right" />
                        <CheckBox
                            VerticalAlignment="Center"
                            Content="Generate New Child Boundary Activity Code"
                            IsEnabled="{Binding BoundaryCode.CanAutoGenerate}"
                            IsChecked="{Binding BoundaryCode.IsAutoGenerate, Mode=TwoWay}" />
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Opacity" Value="0.65" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BoundaryCode.IsAutoGenerate}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="Code Value" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            IsEnabled="{Binding BoundaryCode.IsAutoGenerate}"
                            Text="{Binding BoundaryCode.UserEnteredValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            Margin="2"
                            />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="Code Description" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            IsEnabled="{Binding BoundaryCode.IsAutoGenerate}"
                            Text="{Binding BoundaryCode.UserEnteredDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            Margin="2"
                            />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="Info" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding BoundaryCode.Info}" />
                        <DockPanel Margin="0,6"                             
                            Grid.Row="3"
                            Grid.Column="1">
                            <Button
                                Width="96"
                                Margin="6,0,0,0"
                                HorizontalAlignment="Right"
                                IsEnabled="{Binding BoundaryCode.IsAutoGenerate}"
                                Command="{Binding BoundaryCode.AutoGenerateActivityCodeCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Content="Generate New"
                            DockPanel.Dock="Right"/>
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="BOUNDARY ACTIVITY CODE" />

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementIdCode.IsAutoGenerate}" Value="True">
                                        <Setter Property="Opacity" Value="0.45" />
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="Code Value" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding ElementIdCode.SelectedCodeValue}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="Code Description" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding ElementIdCode.SelectedCodeDescription}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="Code Path" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding ElementIdCode.SelectedCodePath}" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="Code Value Id" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding ElementIdCode.SelectedCodeValueId}" />
                    </Grid>

                    <DockPanel Margin="0,6">
                        <CheckBox
                            VerticalAlignment="Center"
                            Content="Auto Generate Element-Id Code Value"
                            IsEnabled="{Binding ElementIdCode.CanAutoGenerate}"
                            IsChecked="{Binding ElementIdCode.IsAutoGenerate, Mode=TwoWay}" />
                        <Button
                            Width="96"
                            Margin="6,0,0,0"
                            HorizontalAlignment="Right"
                            Command="{Binding ElementIdCode.SelectCodeNodeCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="Select"
                            DockPanel.Dock="Right" />
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Opacity" Value="0.65" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementIdCode.IsAutoGenerate}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="Code Value" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Visibility="{Binding ElementIdCode.IsNumericSelectionVisibility}"
                            IsEnabled="False"
                            Text="{Binding ElementIdCode.NextNumericValue, Mode=OneWay}" 
                            Margin="2"
                            />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Visibility="{Binding ElementIdCode.IsTextSelectionVisibility}"
                            IsEnabled="{Binding ElementIdCode.CanEditValue}"
                            Text="{Binding ElementIdCode.UserEnteredValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            Margin="2"
                            />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="Code Description" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            IsEnabled="{Binding ElementIdCode.CanEditDescription}"
                            Text="{Binding ElementIdCode.UserEnteredDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            Margin="2"
                            />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="Info" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding ElementIdCode.Info}" />
                        <DockPanel 
                            Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,6">
                            <CheckBox
                                Content="Copy Activities Under New Element ID"
                                IsChecked="True" />
                            <Button
                                Width="120"
                                HorizontalAlignment="Right"
                                Content="Manage Options"
                                DockPanel.Dock="Right" 
                                Command="{Binding ElementIdCode.ManageCopyActivitiesOptionsCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                        </DockPanel>
                        <StackPanel 
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,6"                             
                            Grid.Row="4"
                            Grid.Column="1">
                            <Button
                                Width="160"
                                Margin="6,0,6,0"
                                HorizontalAlignment="Center"
                                Content="Generate First Element-Id"
                                Command="{Binding ElementIdCode.GenerateFirstLeafCommand}"
                                Visibility="{Binding ElementIdCode.GenerateFirstLeafVisibility}" />
                            <Button
                                Width="96"
                                Margin="6,0,0,0"
                                HorizontalAlignment="Right"
                                IsEnabled="{Binding ElementIdCode.IsAutoGenerate}"
                                Command="{Binding ElementIdCode.AutoGenerateActivityCodeCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Content="Generate New"
                            DockPanel.Dock="Right"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="BLOCK TYPE" />
                    
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ACadBlockVM.IsCopyBlockDefinition}" Value="True">
                                        <Setter Property="Opacity" Value="0.45" />
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="Block ObjectId" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding ACadBlockVM.SelectedBTRObjId}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="Block Name" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding ACadBlockVM.SelectedBTRName}" />
                    </Grid>
                    
                    <UniformGrid Margin="0,8,0,6" Columns="2">
                        <RadioButton
                            Margin="2"
                            Content="Predefined"
                            IsChecked="{Binding ACadBlockVM.BlockTypeMode, Mode=TwoWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Predefined}" />
                        <RadioButton
                            Margin="2"
                            Content="From Drawing"
                            IsChecked="{Binding ACadBlockVM.BlockTypeMode, Mode=TwoWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SelectFromDrawing}" />
                    </UniformGrid>

                    <Grid Visibility="{Binding ACadBlockVM.BlockTypeMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Predefined}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            Grid.Column="0"
                            Margin="0,0,6,0"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding ACadBlockVM.AvailableBlocks}"
                            SelectedItem="{Binding ACadBlockVM.SelectedPredefinedBlock, Mode=TwoWay}">

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="DropDownOpened">
                                    <i:InvokeCommandAction Command="{Binding ACadBlockVM.RefreshAvailableBlocksCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            
                        </ComboBox>
                        <Button
                            Grid.Column="1"
                            Command="{Binding ACadBlockVM.BrowseBlocksFolderCommand}"
                            Content="Open Folder" />
                    </Grid>

                    <Grid Visibility="{Binding ACadBlockVM.BlockTypeMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=SelectFromDrawing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="1"
                            Command="{Binding ACadBlockVM.SelectBlockFromDrawingCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="Select Block" />
                    </Grid>

                    <CheckBox
                        Margin="0,8,0,0"
                        IsEnabled="{Binding ACadBlockVM.CanAutoGenerate}"
                        Content="Copy block definition as independent block"
                        IsChecked="{Binding ACadBlockVM.IsCopyBlockDefinition, Mode=TwoWay}" />

                    <TextBox
                            Grid.Column="0"
                            IsEnabled="{Binding ACadBlockVM.IsCopyBlockDefinition}"
                            Text="{Binding ACadBlockVM.NewBlockName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            Margin="75,6,75,0"
                            />
                    
                    <Button
                            Grid.Column="0"
                            Width="96"
                            Margin="6"
                            IsEnabled="{Binding ACadBlockVM.IsCopyBlockDefinition}"
                            HorizontalAlignment="Center"
                            Command="{Binding ACadBlockVM.GenerateNewBTRCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="Generate New" />
                    
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="INSERT OPTIONS" />
                    <Button
                        Height="32"
                        Margin="0,8,0,6"
                        Command="{Binding InsertBlockCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="{Binding InsertButtonText}" />
                    <CheckBox
                        Margin="0,2"
                        Content="Continuously Insert Blocks"
                        IsChecked="{Binding ContinuousInsert, Mode=TwoWay}" />
                    <CheckBox
                        Margin="0,2"
                        Content="Edit Legend Position"
                        IsChecked="{Binding EditLegendPosition, Mode=TwoWay}" />
                    <Button
                        Height="30"
                        Margin="0,35,0,0"
                        Command="{Binding CancelCommand}"
                        Content="Cancel" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="#555"
                        Text="{Binding StatusMessage}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
