<Window
    x:Class="Autocad_Primavera_P6_Plugin.UserInterface.UI_InsertBlocksWindowView.InsertBlocksWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="P6 Autocad - Insert Blocks"
    Width="450"
    Height="900"
    ResizeMode="CanResize"
    Topmost="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel
            Margin="5"
            HorizontalAlignment="Stretch"
            Orientation="Vertical">

            <TextBlock Margin="0" TextWrapping="Wrap">
                Use this window to insert blocks into your AutoCAD drawing.<LineBreak />
                -<Bold>BOUNDRY ACTIVITY CODE :</Bold>
                Select/auto-create "Boundry-Activity-Codes".<LineBreak />
                -<Bold>ITEM ID ACTIVITY CODE :</Bold>
                Select/auto-create "ItemId-Activity-Codes".<LineBreak />
                -<Bold>BLOCK TYPE :</Bold>
                Select from predefined or select desired block to copy from.<LineBreak />
                -<Bold>INSERT OPTIONS :</Bold><LineBreak />
                - Click to cintinuously insert blocks one by one.<LineBreak />
                - Click to enable managing leaders for the inserted blocks after insert.<LineBreak />
            </TextBlock>
            <Border
                Margin="0,0,0,5"
                VerticalAlignment="Stretch"
                BorderBrush="Gray"
                BorderThickness="1,1,1,1">
                <StackPanel Width="440" Height="212">
                    <Label Content="BOUNDRY ACTIVITY CODE :" FontWeight="Bold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Content="Code Value :" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Content="-- Code Value --" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Content="Code Path :" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Content="-- Code Path --" />
                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            Content="Code Value Id :" />
                        <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            Content="-- Code Value Id --" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            Width="100"
                            Margin="5"
                            Content="Select" />
                        <CheckBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="5,5,25,5"
                            VerticalAlignment="Center"
                            Content="Auto Generate New Code Value" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Content="Code Value :" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Content="-- Code Value --" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Content="Code Path :" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Content="-- Code Path --" />
                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            Content="Info :" />
                        <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            Content="-- Info --" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border
                Margin="0,0,0,5"
                BorderBrush="Gray"
                BorderThickness="1,1,1,1">
                <StackPanel Width="440" Height="212">
                    <Label Content="ITEM ID ACTIVITY CODE :" FontWeight="Bold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Content="Code Value :" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Content="-- Code Value --" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Content="Code Path :" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Content="-- Code Path --" />
                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            Content="Code Value Id :" />
                        <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            Content="-- Code Value Id --" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            Width="100"
                            Margin="5"
                            Content="Select" />
                        <CheckBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="5,5,25,5"
                            VerticalAlignment="Center"
                            Content="Auto Generate New Code Value" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Content="Code Value :" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Content="-- Code Value --" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Content="Code Path :" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Content="-- Code Path --" />
                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            Content="Info :" />
                        <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            Content="-- Info --" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border
                Margin="0,0,0,5"
                BorderBrush="Gray"
                BorderThickness="1,1,1,1">
                <StackPanel Width="440">
                    <Label Content="BLOCK TYPE :" FontWeight="Bold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="15" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="1"
                            Content="Predefined Blocks" />
                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="3"
                            Content="Select Block to Copy" />
                    </Grid>
                    <ComboBox Margin="5" HorizontalAlignment="Stretch" />
                    <Button
                        Width="200"
                        Margin="5"
                        Content="Select Block from Drawing" />
                </StackPanel>
            </Border>
            <Border Margin="5,20,5,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="200"
                        Content="Insert Block" />
                    <CheckBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="5,5,25,5"
                        VerticalAlignment="Center"
                        Content="Continuously Insert Blocks" />
                    <CheckBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="5,5,25,5"
                        VerticalAlignment="Center"
                        Content="Edit Legend Position" />
                    <Button
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="200"
                        Content="Cancel" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
